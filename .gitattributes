# Normalize line endings to LF in the repository for consistent diffs across OSes.
* text=auto eol=lf

# Treat binary assets as binary (no line-ending conversion).
*.png binary

# Keep development-only files out of the Composer/Packagist dist archive.
# Docs and examples are kept in the dist on purpose (parity with the other SDKs).
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
